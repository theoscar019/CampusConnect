# Copie este archivo a .env (NO subir .env a GitHub) y complete los valores.
# Clave para firmar las sesiones: use un valor largo y aleatorio.
CAMPUSCONNECT_SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria
# Ruta de la base de datos SQLite
CAMPUSCONNECT_DB=campusconnect.db
# Ponga 1 cuando el sistema se publique con HTTPS (cookies solo por canal seguro)
CAMPUSCONNECT_HTTPS=0
